# ── Required ────────────────────────────────────────────────────────────────
# Any PostgreSQL database. Free options: Neon (neon.tech), Supabase, or local Docker.
# Tables are created automatically on first run.
DATABASE_URL=postgres://user:password@host:5432/docsign?sslmode=require

# Password for the admin (sender) dashboard.
ADMIN_PASSWORD=change-me

# Random string, at least 32 characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Public URL of this app, used in signing links (no trailing slash).
# On Vercel this defaults to your production domain.
APP_URL=http://localhost:3000

# ── Branding ────────────────────────────────────────────────────────────────
# Your business name, shown to signers and in emails.
ORG_NAME=Your Company
# Name shown in the browser tab and dashboard header.
APP_NAME=docsign

# ── Email (optional) ────────────────────────────────────────────────────────
# Without email, docsign gives you a signing link to send yourself.
# Configure EITHER Resend OR SMTP.
EMAIL_FROM=Your Company <sign@yourdomain.com>
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_SECURE=false

# Also send a copy of every signed document here.
# NOTIFY_EMAIL=you@yourdomain.com

# ── Other (optional) ────────────────────────────────────────────────────────
# Days until a signing link expires (0 = never). Each document can override it.
# DEFAULT_EXPIRES_DAYS=30
# Fallback time zone for dates stamped on documents (the signer's own time zone is used when available).
# TIMEZONE=America/New_York
